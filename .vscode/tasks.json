{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "process",
            "command": "${env:HOME}/.local/bin/cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "process",
            "command": "${env:HOME}/.local/bin/cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--parallel",
                "2"
            ],
            "dependsOn": "CMake: configure",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
